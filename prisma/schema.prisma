generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ConsumeHistory {
  userId            Int     @id @map("user_id")
  savingsRate       Decimal @map("savings_rate") @db.Decimal(5, 2)
  investmentRate    Decimal @map("investment_rate") @db.Decimal(5, 2)
  leisureRate       Decimal @map("leisure_rate") @db.Decimal(5, 2)
  livingExpenseRate Decimal @map("living_expense_rate") @db.Decimal(5, 2)
  otherRate         Decimal @map("other_rate") @db.Decimal(5, 2)
  user              User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "ConsumeHistory_user_id_fkey")
}

model UserFinancialProduct {
  userId           Int              @map("user_id")
  currentValue     BigInt           @map("current_value")
  productEndDate   DateTime?        @map("product_end_date")
  productId        Int              @map("product_id")
  userProductId    Int              @id @default(autoincrement()) @map("user_product_id")
  financialProduct FinancialProduct @relation(fields: [productId], references: [productId])
  user             User             @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "UserFinancialProduct_user_id_fkey")
  @@index([productId], map: "UserFinancialProduct_product_id_fkey")
}

model FinancialProduct {
  productId            Int                    @id @default(autoincrement()) @map("product_id")
  productName          String                 @map("product_name")
  institutionName      String                 @map("institution_name")
  riskLevel            RiskLevel              @map("risk_level")
  category             ProductCategory        @map("category")
  userFinancialProduct UserFinancialProduct[]
}

model UserMatchLog {
  matchId     Int         @id @default(autoincrement()) @map("match_id")
  sentId      Int         @map("sent_id")
  receiveId   Int         @map("receive_id")
  matchStatus MatchStatus @map("match_status")
  received    User        @relation("ReceivedMatches", fields: [receiveId], references: [userId], onDelete: Cascade)
  sent        User        @relation("SentMatches", fields: [sentId], references: [userId], onDelete: Cascade)

  @@index([receiveId], map: "UserMatchLog_receive_id_fkey")
  @@index([sentId], map: "UserMatchLog_sent_id_fkey")
}

model UserRecoLog {
  recommendId Int      @id @default(autoincrement()) @map("recommend_id")
  createdAt   DateTime @default(now()) @map("created_at")
  baseUserId  Int      @map("base_user")
  candidateId Int      @map("candidate_id")
  likeStatus  Boolean  @default(false) @map("like_status")
  baseUser    User     @relation("BaseUserReco", fields: [baseUserId], references: [userId])

  @@index([baseUserId], map: "UserRecoLog_base_user_fkey")
}

model Loan {
  loanId              Int      @id @default(autoincrement()) @map("loan_id")
  userId              Int      @map("user_id")
  loanName            String   @map("loan_name")
  loanInstitutionName String   @map("loan_institution_name")
  loanBalance         BigInt   @map("loan_balance")
  loanRate            Decimal  @map("loan_rate") @db.Decimal(5, 2)
  loanEndDate         DateTime @map("loan_end_date")
  user                User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "Loan_user_id_fkey")
}

model ChatMessage {
  messageId Int      @id @default(autoincrement()) @map("message_id")
  roomId    Int      @map("room_id")
  userId    Int      @map("user_id")
  message   String   @map("message")
  regdate   DateTime @map("regdate")
  chatRoom  ChatRoom @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([roomId], map: "ChatMessage_room_id_fkey")
  @@index([userId], map: "ChatMessage_user_id_fkey")
}

model ChatRoom {
  roomId        Int           @id @default(autoincrement()) @map("room_id")
  userId        Int           @map("user_id")
  userId2       Int           @map("user_id2")
  isAgree       Boolean?      @map("is_agree")
  isAgree2      Boolean?      @map("is_agree2")
  lastMessage   String?       @map("last_message")
  lastMessageAt DateTime?     @map("last_message_at")
  chatMessage   ChatMessage[]
  user2         User          @relation("ChatUser2", fields: [userId2], references: [userId])
  user          User          @relation("ChatUser1", fields: [userId], references: [userId])

  @@index([userId], map: "ChatRoom_user_id_fkey")
  @@index([userId2], map: "ChatRoom_user_id2_fkey")
}

model PairingAnswer {
  id               Int         @id @default(autoincrement()) @map("id")
  userId           Int         @unique @map("user_id")
  carBudget        BigInt      @map("car_budget")
  dateBudget       Int         @map("date_budget")
  shoesBudget      Int         @map("shoes_budget")
  preferredCity    String      @map("preferred_city")
  idealIncomeRange IncomeRange @map("ideal_income_range")
  createdAt        DateTime    @default(now()) @map("created_at")
  user             User        @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "PairingAnswer_user_id_fkey")
}

model User {
  userId               Int                    @id @default(autoincrement()) @map("user_id")
  email                String                 @unique
  birthYear            Int                    @map("birth_year")
  carValue             BigInt?                @map("car_value")
  city                 String                 @db.VarChar(20)
  createdAt            DateTime               @default(now()) @map("created_at")
  currentType          InvestmentType?        @map("current_type")
  description          String?                @db.VarChar(100)
  gender               Gender
  goalAmount           BigInt?                @map("goal_amount")
  goalPeriod           GoalPeriod?            @map("goal_period")
  goalType             GoalType?              @map("goal_type")
  hasCar               Boolean?               @default(false) @map("has_car")
  hasHouse             Boolean?               @default(false) @map("has_house")
  houseValue           BigInt?                @map("house_value")
  job                  String?                @db.VarChar(20)
  nickname             String                 @db.VarChar(10)
  password             String                 @db.VarChar(100)
  preferredType        InvestmentType?        @map("preferred_type")
  profileImage         String?                @map("profile_image")
  isDeleted            Boolean                @default(false) @map("is_deleted")
  chatMessage          ChatMessage[]
  chatRooms2           ChatRoom[]             @relation("ChatUser2")
  chatRooms1           ChatRoom[]             @relation("ChatUser1")
  consumeHistory       ConsumeHistory?
  loan                 Loan[]
  pairingAnswer        PairingAnswer?
  userFinancialProduct UserFinancialProduct[]
  receivedMatches      UserMatchLog[]         @relation("ReceivedMatches")
  sentMatches          UserMatchLog[]         @relation("SentMatches")
  userQuizLog          UserQuizLog[]
  UserRecoLog          UserRecoLog[]          @relation("BaseUserReco")
}

model Subject {
  subjectId    Int           @id @default(autoincrement()) @map("subject_id")
  title        String        @map("title")
  description  String        @map("description")
  features     String        @map("features")
  period       String        @map("period")
  amount       String        @map("amount")
  interestRate String        @map("interest_rate")
  createdAt    DateTime      @default(now()) @map("created_at")
  subjectType  String        @map("subject_type")
  subjectUrl   String?       @map("subject_url")
  quiz         Quiz[]
  userQuizLog  UserQuizLog[]
}

model Quiz {
  quizId      Int      @id @default(autoincrement()) @map("quiz_id")
  subjectId   Int      @map("subject_id")
  question    String   @map("question")
  explanation String   @map("explanation")
  answer      Boolean  @map("answer")
  createdAt   DateTime @default(now()) @map("created_at")
  subject     Subject  @relation(fields: [subjectId], references: [subjectId], onDelete: Cascade)

  @@index([subjectId])
}

model UserQuizLog {
  quizLogId Int      @id @default(autoincrement()) @map("quiz_log_id")
  userId    Int      @map("user_id")
  subjectId Int      @map("subject_id")
  createdAt DateTime @default(now()) @map("created_at")
  isPassed  Boolean  @map("is_passed")
  subject   Subject  @relation(fields: [subjectId], references: [subjectId], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, subjectId], map: "UserQuizLog_user_subject_idx")
  @@index([subjectId], map: "UserQuizLog_subject_id_fkey")
  @@index([userId], map: "UserQuizLog_user_id_fkey")
}

enum Gender {
  M
  F
}

enum InvestmentType {
  CONSERVATIVE    @map("안정형")
  MODERATE        @map("안정추구형")
  NEUTRAL         @map("위험중립형")
  AGGRESSIVE      @map("적극투자형")
  VERY_AGGRESSIVE @map("공격투자형")
}

enum GoalType {
  HOUSE      @map("내집마련")
  LUMPSUM    @map("목돈마련")
  RETIREMENT @map("노후자금")
  MARRIAGE   @map("결혼자금")
}

enum GoalPeriod {
  WITHIN_1_YEAR     @map("1년 이내")
  WITHIN_3_YEARS    @map("3년 이내")
  WITHIN_5_YEARS    @map("5년 이내")
  MORE_THAN_5_YEARS @map("5년 이상")
}

enum ProductCategory {
  SAVINGS
  DOMESTIC_STOCKS
  DEVELOPED_STOCKS
  EMERGING_STOCKS
  DOMESTIC_BONDS
  FOREIGN_BONDS
  ALTERNATIVE
  CASH
  LOAN
}

enum RiskLevel {
  VERY_HIGH
  HIGH
  LITTLE_HIGH
  MEDIUM
  LOW
  VERY_LOW
}

enum IncomeRange {
  NEAR_400
  NEAR_600
  NEAR_800
  OVER_1000
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}
